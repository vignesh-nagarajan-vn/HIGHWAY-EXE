# Copy to .env and fill in. .env is gitignored.

# READER-A: local small language model served by Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# VALIDATOR: Claude Haiku, only called when the two readers disagree
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Enterprise server started from vendor/hack_the_highway_package
ENTERPRISE_URL=http://127.0.0.1:8000

# Rule 3 ambiguity switches (see docs/design_card.md)
TRANSFER_FROM=today
